# Firebase Console > Project settings > General > Your apps > Web app config.
# These web app values are public configuration; never put R2 credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_ADMIN_EMAILS=admin@example.com

# URL printed by `npm run media:dev`, or the deployed Cloudflare Worker URL.
VITE_MEDIA_API_URL=

# Optional address reverse-geocoder endpoint (defaults to OpenStreetMap Nominatim).
VITE_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
