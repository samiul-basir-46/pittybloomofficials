+export function validatePhotos({ copies, photos, settings, busy, failed }) {
+  const errors = {}
+  if (busy) errors.uploading = 'Please wait for your photos to finish uploading.'
+  else if (failed) errors.uploading = 'Some photos could not be uploaded. Try again or remove them to continue.'
+  if (settings.photosRequired === 'No') return errors
+  copies.forEach((c) => {
+    const m = photos[c.key] ?? {}
+    const files = m.files ?? []
+    if (files.length === 0) return void (errors[`${c.key}.photos`] = 'Please add at least one photo for this magazine.')
+    if (!files.some((f) => f.id === m.front)) errors[`${c.key}.front`] = 'Please choose the Front Page photo.'
+    if (!files.some((f) => f.id === m.back)) errors[`${c.key}.back`] = 'Please choose the Back Page photo.'
+  })
+  return errors
+}
