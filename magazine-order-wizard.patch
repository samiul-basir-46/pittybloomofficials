new file mode 100644
index 0000000..dd37834
--- /dev/null
+++ b/src/shared/services/photoService.js
@@ -0,0 +1,123 @@
+// Customer photos for magazine orders.
+//
+// TODAY: photos are saved in this browser's IndexedDB, so they survive refreshes, step changes and visits to the cart,
+// and the Admin Orders page can show and zip them on the same device.
+//
+// LATER (Firebase Storage): replace the bodies of upload / getBlob / remove / removeByPrefix with
+// uploadBytesResumable / getBlob / deleteObject / listAll. Keep the same inputs and outputs and nothing else
+// in the app needs to change. onProgress already receives 0–100, which maps onto the upload task's progress.
+const DB_NAME = 'pittybloom-photos'
+const STORE = 'photos'
+
+export const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif']
+const EXTENSIONS = /\.(jpe?g|png|webp|heic|heif)$/i
+export const TYPE_HINT = 'JPG, PNG, WEBP or HEIC'
+
+const openDb = () =>
+  new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1)
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE)
+    req.onsuccess = () => resolve(req.result)
+    req.onerror = () => reject(req.error)
+  })
+
+const run = (mode, action) =>
+  openDb().then(
+    (db) =>
+      new Promise((resolve, reject) => {
+        const tx = db.transaction(STORE, mode)
+        const req = action(tx.objectStore(STORE))
+        tx.oncomplete = () => {
+          db.close()
+          resolve(req?.result)
+        }
+        tx.onabort = tx.onerror = () => {
+          db.close()
+          reject(tx.error ?? req?.error)
+        }
+      }),
+  )
+
+const readBuffer = (file, onProgress) =>
+  new Promise((resolve, reject) => {
+    const reader = new FileReader()
+    reader.onprogress = (e) => e.lengthComputable && onProgress?.(e.loaded / e.total)
+    reader.onload = () => resolve(reader.result)
+    reader.onerror = () => reject(reader.error ?? new Error('read failed'))
+    reader.readAsArrayBuffer(file)
+  })
+
+const guessType = (name) => {
+  const ext = name.split('.').pop().toLowerCase()
+  return { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', heic: 'image/heic', heif: 'image/heif' }[ext] ?? 'image/jpeg'
+}
+
+// A small preview so big galleries stay fast. Browsers that cannot decode the file (HEIC) simply get no preview.
+async function makeThumb(file) {
+  try {
+    if (typeof createImageBitmap !== 'function' || typeof document === 'undefined') return null
+    const bitmap = await createImageBitmap(file)
+    const scale = Math.min(1, 360 / Math.max(bitmap.width, bitmap.height))
+    const canvas = document.createElement('canvas')
+    canvas.width = Math.max(1, Math.round(bitmap.width * scale))
+    canvas.height = Math.max(1, Math.round(bitmap.height * scale))
+    canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height)
+    bitmap.close?.()
+    const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.8))
+    return blob ? { buffer: await blob.arrayBuffer(), type: 'image/jpeg' } : null
+  } catch {
+    return null
+  }
+}
+
+// Returns a message for the customer, or '' when the file is fine.
+export const validatePhoto = (file, maxMB = 15) => {
+  const typeOk = ALLOWED_TYPES.includes(file.type) || (!file.type && EXTENSIONS.test(file.name))
+  if (!typeOk) return `${file.name}: only ${TYPE_HINT} pictures can be added.`
+  if (file.size === 0) return `${file.name} is empty.`
+  if (file.size > maxMB * 1024 * 1024) return `${file.name} is ${(file.size / 1048576).toFixed(1)} MB. The limit is ${maxMB} MB per photo.`
+  return ''
+}
+
+export const photoService = {
+  // → { path, thumbPath, name, size, type }
+  async upload(file, { path, onProgress }) {
+    onProgress?.(0)
+    const buffer = await readBuffer(file, (p) => onProgress?.(Math.round(p * 90)))
+    const thumb = await makeThumb(file)
+    const type = file.type || guessType(file.name)
+    const thumbPath = thumb ? `${path}.thumb` : null
+    try {
+      await run('readwrite', (s) => {
+        if (thumb) s.put(thumb, thumbPath)
+        return s.put({ buffer, type }, path)
+      })
+    } catch (error) {
+      throw new Error(
+        error?.name === 'QuotaExceededError'
+          ? 'There is not enough storage space on this device for this photo.'
+          : 'The photo could not be saved. Please try again.',
+      )
+    }
+    onProgress?.(100)
+    return { path, thumbPath, name: file.name, size: file.size, type }
+  },
+
+  async getBlob(path) {
+    const record = await run('readonly', (s) => s.get(path))
+    return record ? new Blob([record.buffer], { type: record.type }) : null
+  },
+
+  // file: a photo record ({ path, thumbPath })
+  async remove(file) {
+    await run('readwrite', (s) => {
+      if (file.thumbPath) s.delete(file.thumbPath)
+      return s.delete(file.path)
+    })
+  },
+
+  // Every photo of one order lives under orders/<orderId>/
+  async removeByPrefix(prefix) {
+    await run('readwrite', (s) => s.delete(IDBKeyRange.bound(prefix, `${prefix}\uffff`)))
+  },
+}
