@@ -0,0 +1,42 @@
+// The order in progress. sessionStorage keeps it across a refresh (never across a closed tab),
+// so moving Back and Continue between steps never loses what the customer typed.
+const KEY = 'pb:order-draft'
+
+export const emptyDelivery = { recipient: '', phone: '', address: '', city: '', location: '', date: '' }
+export const emptyContact = { name: '', phone: '', email: '', note: '' }
+
+export const freshDraft = (magazineId, size) => ({
+  magazineId,
+  reached: 1,
+  picks: size ? { [size.format]: { sizeId: size.id, qty: 1 } } : {},
+  addons: [],
+  customs: {},
+  photos: {},
+  delivery: { ...emptyDelivery },
+  contact: { ...emptyContact },
+})
+
+export const orderDraft = {
+  get(magazineId) {
+    try {
+      const saved = JSON.parse(sessionStorage.getItem(KEY))
+      return saved && saved.magazineId === magazineId ? saved : null
+    } catch {
+      return null
+    }
+  },
+  set(value) {
+    try {
+      sessionStorage.setItem(KEY, JSON.stringify(value))
+    } catch {
+      // the flow still works in memory if storage is blocked
+    }
+  },
+  clear() {
+    try {
+      sessionStorage.removeItem(KEY)
+    } catch {
+      // nothing to clear
+    }
+  },
+}
diff --git a/src/pages/order/lib/photoStore.js b/src/pages/order/lib/photoStore.js
new file mode 100644
index 0000000..29c1e1b
--- /dev/null
+++ b/src/pages/order/lib/photoStore.js
@@ -0,0 +1,33 @@
+// Photos the customer picked, held in memory for the current visit only.
+// There is no online storage connected yet (see data.js → photosNote), so the files are previewed and counted,
+// the order records how many were chosen, and the customer sends the files on WhatsApp.
+const store = new Map() // copyKey → [{ id, name, size, url }]
+
+const newId = () => globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`
+
+export const photoStore = {
+  list: (key) => store.get(key) ?? [],
+  // Returns { added, skipped, rejected } so the screen can explain what happened.
+  add(key, files) {
+    const current = store.get(key) ?? []
+    const result = { added: [], skipped: 0, rejected: 0 }
+    Array.from(files).forEach((file) => {
+      if (!file.type?.startsWith('image/')) return void result.rejected++
+      if (current.some((p) => p.name === file.name && p.size === file.size)) return void result.skipped++
+      const photo = { id: newId(), name: file.name, size: file.size, url: URL.createObjectURL?.(file) ?? '' }
+      current.push(photo)
+      result.added.push(photo)
+    })
+    store.set(key, current)
+    return result
+  },
+  remove(key, id) {
+    const current = store.get(key) ?? []
+    current.filter((p) => p.id === id).forEach((p) => p.url && URL.revokeObjectURL?.(p.url))
+    store.set(key, current.filter((p) => p.id !== id))
+  },
+  clear() {
+    store.forEach((list) => list.forEach((p) => p.url && URL.revokeObjectURL?.(p.url)))
+    store.clear()
+  },
+}
diff --git a/src/pages/order/lib/pricing.js b/src/pages/order/lib/pricing.js
new file mode 100644
index 0000000..cc19a47
--- /dev/null
+++ b/src/pages/order/lib/pricing.js
@@ -0,0 +1,94 @@
+// Pure price and delivery-date rules for the magazine order. No React in here, so it is easy to test.
+
+const pad = (n) => String(n).padStart(2, '0')
+const num = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0)
+
+// Dates travel as 'YYYY-MM-DD' strings so time zones can never shift a day.
+export const toISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`
+export const fromISO = (iso) => {
+  const [y, m, d] = iso.split('-').map(Number)
+  return new Date(y, m - 1, d)
+}
+const dayNumber = (iso) => {
+  const [y, m, d] = iso.split('-').map(Number)
+  return Math.round(Date.UTC(y, m - 1, d) / 86400000)
+}
+export const daysBetween = (fromIso, toIso) => dayNumber(toIso) - dayNumber(fromIso)
+
+// The day an order counts from: today, or tomorrow once the cut-off hour has passed.
+export const orderingDay = (now = new Date(), cutoffHour = 18) =>
+  toISO(new Date(now.getFullYear(), now.getMonth(), now.getDate() + (now.getHours() >= num(cutoffHour) ? 1 : 0)))
+
+// "1 | 100" per line → [{ days: 1, charge: 100 }]
+export const parseRushRules = (text = '') =>
+  text
+    .split('\n')
+    .map((line) => {
+      const [days, charge] = line.split('|').map((s) => Number(s.trim()))
+      return { days, charge }
+    })
+    .filter((r) => Number.isInteger(r.days) && r.days >= 1 && Number.isFinite(r.charge) && r.charge >= 0)
+    .sort((a, b) => a.days - b.days)
+
+// 'inside' (Inside Dhaka) may order for tomorrow; 'outside' needs a longer lead time.
+export const earliestDays = (location, settings) =>
+  location === 'outside' ? Math.max(1, num(settings.outsideMinDays) || 1) : 1
+
+export const checkDate = (iso, location, settings, now = new Date()) => {
+  const ahead = daysBetween(orderingDay(now, settings.cutoffHour), iso)
+  if (ahead < earliestDays(location, settings)) return { allowed: false, ahead, rush: 0 }
+  const rule = location === 'inside' ? parseRushRules(settings.rushRules).find((r) => r.days === ahead) : null
+  return { allowed: true, ahead, rush: rule ? rule.charge : 0 }
+}
+
+export const deliveryCharge = (location, settings) =>
+  location === 'inside' ? num(settings.insideDhakaCharge) : location === 'outside' ? num(settings.outsideDhakaCharge) : 0
+
+// copies: [{ size }]   addons: [{ price, qty }]
+export function calcTotals({ copies, addons = [], location = '', date = '', settings, now = new Date() }) {
+  const magazineTotal = copies.reduce((sum, c) => sum + num(c.size.price), 0)
+  const savings = copies.reduce((sum, c) => sum + Math.max(0, num(c.size.mrp) - num(c.size.price)), 0)
+  const addonTotal = addons.reduce((sum, a) => sum + num(a.price) * (a.qty || 1), 0)
+  const delivery = deliveryCharge(location, settings)
+  const dateInfo = location && date ? checkDate(date, location, settings, now) : null
+  const rush = dateInfo?.allowed ? dateInfo.rush : 0
+  return {
+    magazineTotal,
+    savings,
+    addonTotal,
+    deliveryCharge: delivery,
+    rushCharge: rush,
+    rushDays: dateInfo?.allowed && rush > 0 ? dateInfo.ahead : 0,
+    total: magazineTotal + addonTotal + delivery + rush,
+  }
+}
+
+// "16–22" → { min: 16, max: 22 }. Returns null when no range is set.
+export const parseRange = (text = '') => {
+  const [min, max = min] = String(text)
+    .split(/[–—-]/)
+    .map((s) => parseInt(s.trim(), 10))
+  return Number.isFinite(min) ? { min, max: Number.isFinite(max) ? max : min } : null
+}
+
+// "Inside Dhaka: 1 day is +৳100, 2 days is +৳50 …" built from the live settings, so it never goes out of date.
+export const rushSentence = (settings, formatPrice) => {
+  const rules = parseRushRules(settings.rushRules)
+  if (!rules.length) return ''
+  const parts = rules.map((r) => `${r.days} day${r.days > 1 ? 's' : ''} is +${formatPrice(r.charge)}`)
+  const hour = num(settings.cutoffHour)
+  const cutoff =
+    hour > 0 && hour < 24
+      ? ` (Orders placed after ${hour % 12 || 12}:00 ${hour >= 12 ? 'PM' : 'AM'} count from the next day).`
+      : '.'
+  return `Inside Dhaka: ${parts.join(', ')}${cutoff}`
+}
+
+// Written out by hand so the text is identical in every browser and language setting.
+const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
+export const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
+export const shortDate = (iso) => {
+  const d = fromISO(iso)
+  return `${WEEKDAYS[d.getDay()]}, ${d.getDate()} ${MONTHS[d.getMonth()]}`
+}
+export const longDate = (iso) => `${shortDate(iso)} ${fromISO(iso).getFullYear()}`
diff --git a/src/pages/order/lib/validation.js b/src/pages/order/lib/validation.js
new file mode 100644
index 0000000..b898d00
--- /dev/null
+++ b/src/pages/order/lib/validation.js
@@ -0,0 +1,60 @@
+import { checkDate } from './pricing'
+
+export const cleanPhone = (v = '') => v.replace(/[\s-]/g, '')
+export const isPhone = (v) => /^(?:\+?88)?01[3-9]\d{8}$/.test(cleanPhone(v))
+const isEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
+const blank = (v) => !String(v ?? '').trim()
+
+export const PHONE_MESSAGE = 'Enter a valid mobile number, like 01712345678.'
+
+// Every validator returns { fieldKey: 'message' }. An empty object means the step is fine.
+
+export function validateMagazine({ picks, formats }) {
+  const errors = {}
+  const chosen = formats.filter((f) => picks[f.id])
+  if (chosen.length === 0) errors.picks = 'Please choose at least one magazine size.'
+  chosen.forEach((f) => {
+    if (!picks[f.id].sizeId) errors[`pages.${f.id}`] = 'Please choose the number of pages.'
+  })
+  return errors
+}
+
+export function validateCustomize({ copies, customs, occasions }) {
+  const errors = {}
+  if (occasions.length === 0) return errors // nothing to ask until occasions are set up in Admin
+  copies.forEach((c) => {
+    const custom = customs[c.key]
+    const occasion = occasions.find((o) => o.id === custom?.occasionId)
+    if (!occasion) {
+      errors[`${c.key}.occasion`] = 'Please choose an occasion for this magazine.'
+      return
+    }
+    occasion.fields.forEach((f) => {
+      const value = custom.values?.[f.id] ?? ''
+      if (f.required && blank(value)) errors[`${c.key}.${f.id}`] = 'This field is required.'
+    })
+  })
+  return errors
+}
+
+export function validateDelivery({ delivery, settings, now }) {
+  const errors = {}
+  if (blank(delivery.phone)) errors.phone = 'Please enter a contact number for delivery.'
+  else if (!isPhone(delivery.phone)) errors.phone = PHONE_MESSAGE
+  if (blank(delivery.address)) errors.address = 'Please enter the full address.'
+  if (blank(delivery.city)) errors.city = 'Please enter the city or district.'
+  if (!delivery.location) errors.location = 'Please choose Inside Dhaka or Outside Dhaka.'
+  if (!delivery.date) errors.date = 'Please choose the date you need the magazine.'
+  else if (delivery.location && !checkDate(delivery.date, delivery.location, settings, now).allowed)
+    errors.date = 'This date is no longer available. Please pick another date.'
+  return errors
+}
+
+export function validateContact({ contact }) {
+  const errors = {}
+  if (blank(contact.name)) errors.name = 'Please enter your name.'
+  if (blank(contact.phone)) errors.contactPhone = 'Please enter your phone number.'
+  else if (!isPhone(contact.phone)) errors.contactPhone = PHONE_MESSAGE
+  if (!blank(contact.email) && !isEmail(contact.email)) errors.email = 'This email address does not look right.'
+  return errors
+}
