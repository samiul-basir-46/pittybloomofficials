diff --git a/src/admin/orderZip.js b/src/admin/orderZip.js
new file mode 100644
index 0000000..7af3d0d
--- /dev/null
+++ b/src/admin/orderZip.js
@@ -0,0 +1,59 @@
+import JSZip from 'jszip'
+import { photoService } from '../shared/services/photoService'
+
+const EXT = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/heic': 'heic', 'image/heif': 'heif' }
+const ext = (f) => EXT[f.type] ?? (f.name?.split('.').pop().toLowerCase().replace(/[^a-z0-9]/g, '') || 'jpg')
+const two = (n) => String(n).padStart(2, '0')
+
+// Every photo of an order with the path it gets inside the ZIP:
+//   ORDER-ID/Magazine-1/Copy-1/Front.jpg, Back.jpg, Photo-01.jpg …
+export function zipEntries(order) {
+  const entries = []
+  let fallback = 0
+  order.items
+    .filter((i) => i.kind === 'magazine' && i.photos?.files?.length)
+    .forEach((item) => {
+      fallback += 1
+      const magazine = item.photos.magazineNo ?? fallback
+      const copy = item.photos.copyNo ?? 1
+      const folder = `${order.id}/Magazine-${magazine}/Copy-${copy}`
+      let extra = 0
+      item.photos.files.forEach((file) => {
+        const base = file.role === 'front' ? 'Front' : file.role === 'back' ? 'Back' : `Photo-${two(++extra)}`
+        entries.push({ path: `${folder}/${base}.${ext(file)}`, file })
+      })
+    })
+  return entries
+}
+
+export const photoCount = (order) => zipEntries(order).length
+
+// Returns { blob, added, missing }. Photos that cannot be read are listed in missing instead of failing the whole download.
+export async function buildOrderZip(order, onProgress) {
+  const entries = zipEntries(order)
+  const zip = new JSZip()
+  const missing = []
+  let done = 0
+  for (const { path, file } of entries) {
+    const blob = await photoService.getBlob(file.path).catch(() => null)
+    if (blob) zip.file(path, blob)
+    else missing.push(path)
+    onProgress?.(++done, entries.length)
+  }
+  if (missing.length === entries.length) throw new Error('These photos are not stored on this device.')
+  const blob = await zip.generateAsync({ type: 'blob', compression: 'STORE' }) // photos are already compressed
+  return { blob, added: entries.length - missing.length, missing }
+}
+
+export async function downloadOrderZip(order, onProgress) {
+  const result = await buildOrderZip(order, onProgress)
+  const url = URL.createObjectURL(result.blob)
+  const link = document.createElement('a')
+  link.href = url
+  link.download = `${order.id}.zip`
+  document.body.appendChild(link)
+  link.click()
+  link.remove()
+  setTimeout(() => URL.revokeObjectURL(url), 10000)
+  return result
+}
