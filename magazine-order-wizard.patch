+import { Card, Input } from '../components/FormField'
+
+export default function ContactStep({ ctx }) {
+  const { draft, update, errors, clear } = ctx
+  const c = draft.contact
+  const set = (key, errorKey = key) => (value) => {
+    clear(errorKey)
+    update((d) => ({ ...d, contact: { ...d.contact, [key]: value } }))
+  }
+
+  return (
+    <Card>
+      <h2 className="text-lg font-bold">About you</h2>
+      <p className="mt-1 text-sm text-ink/60">We use this only to confirm your order. This can be different from the delivery person.</p>
+      <div className="mt-5 space-y-4">
+        <Input name="name" label="Your name" required autoComplete="name" placeholder="e.g. Fahim Ahmed" value={c.name} error={errors.name} onChange={set('name')} />
+        <div>
+          <Input
+            name="contactPhone"
+            label="Your phone number"
+            required
+            type="tel"
+            inputMode="tel"
+            autoComplete="tel"
+            placeholder="01XXXXXXXXX"
+            hint="Preferably the number you use on WhatsApp."
+            value={c.phone}
+            error={errors.contactPhone}
+            onChange={set('phone', 'contactPhone')}
+          />
+          {!c.phone && draft.delivery.phone && (
+            <button
+              type="button"
+              onClick={() => set('phone', 'contactPhone')(draft.delivery.phone)}
+              className="mt-2 text-sm font-medium text-brand hover:underline"
+            >
+              Use the delivery number ({draft.delivery.phone})
+            </button>
+          )}
+        </div>
+        <Input
+          name="email"
+          label="Email"
+          type="email"
+          autoComplete="email"
+          placeholder="you@example.com"
+          value={c.email}
+          error={errors.email}
+          onChange={set('email')}
+        />
+        <Input
+          name="note"
+          label="Anything else we should know?"
+          multiline
+          rows={3}
+          placeholder="e.g. a theme or colour you like, or a message for our team"
+          value={c.note}
+          onChange={set('note')}
+        />
+      </div>
+    </Card>
+  )
+}
diff --git a/src/pages/order/steps/CustomizeStep.jsx b/src/pages/order/steps/CustomizeStep.jsx
new file mode 100644
index 0000000..0dc6d38
--- /dev/null
+++ b/src/pages/order/steps/CustomizeStep.jsx
@@ -0,0 +1,135 @@
+import { AlertCircle, Copy } from 'lucide-react'
+import { Card, Field, Input, Notice, controlClass } from '../components/FormField'
+import { copyTitle } from '../lib/copies'
+
+export default function CustomizeStep({ ctx }) {
+  const { copies, occasions, draft, update, errors, clear, settings } = ctx
+  const quick = occasions.filter((o) => o.quick === 'Yes')
+
+  const setCustom = (key, patch) =>
+    update((d) => ({
+      ...d,
+      customs: { ...d.customs, [key]: { occasionId: '', values: {}, notes: '', ...d.customs[key], ...patch } },
+    }))
+  const setValue = (key, fieldId, value) => {
+    clear(`${key}.${fieldId}`)
+    setCustom(key, { values: { ...draft.customs[key]?.values, [fieldId]: value } })
+  }
+  const first = copies[0]
+  const firstCustom = first && draft.customs[first.key]
+
+  if (occasions.length === 0)
+    return <Notice tone="warn">Occasions are not set up yet, so there is nothing to fill in here. You can continue.</Notice>
+
+  return (
+    <div className="space-y-6">
+      {copies.map((copy) => {
+        const custom = draft.customs[copy.key] ?? { occasionId: '', values: {}, notes: '' }
+        const occasion = occasions.find((o) => o.id === custom.occasionId)
+        return (
+          <Card key={copy.key} aria-label={copyTitle(copy)}>
+            <div className="flex items-center gap-3 border-b border-sand pb-4">
+              <span className="grid size-8 shrink-0 place-items-center rounded-full bg-brand text-sm font-bold text-white">{copy.number}</span>
+              <h2 className="font-bold">{copyTitle(copy)}</h2>
+            </div>
+
+            {copy.number > 1 && firstCustom?.occasionId && (
+              <button
+                type="button"
+                onClick={() =>
+                  setCustom(copy.key, { occasionId: firstCustom.occasionId, values: { ...firstCustom.values }, notes: firstCustom.notes })
+                }
+                className="mt-4 inline-flex items-center gap-2 rounded-full border border-sand bg-cream px-4 py-2 text-sm font-medium hover:bg-sand"
+              >
+                <Copy size={14} /> Fill with the same details as Book #{first.number}
+              </button>
+            )}
+
+            <div data-field={`${copy.key}.occasion`} className="mt-5">
+              <p className="text-sm font-semibold">
+                What is the occasion? <span className="text-heart">*</span>
+              </p>
+              <p className="mb-3 text-xs text-ink/60">This decides which questions we ask next.</p>
+              <div role="radiogroup" aria-label="Occasion" className="grid grid-cols-3 gap-2">
+                {quick.map((o) => (
+                  <button
+                    key={o.id}
+                    type="button"
+                    role="radio"
+                    aria-checked={custom.occasionId === o.id}
+                    onClick={() => {
+                      clear(`${copy.key}.occasion`)
+                      setCustom(copy.key, { occasionId: o.id })
+                    }}
+                    className={`rounded-xl border-2 px-2 py-3 text-sm font-semibold transition ${
+                      custom.occasionId === o.id ? 'border-brand bg-cream shadow' : 'border-sand bg-white hover:border-brand/40'
+                    }`}
+                  >
+                    <span aria-hidden="true">{o.emoji}</span> {o.label}
+                  </button>
+                ))}
+              </div>
+              <select
+                aria-label="Or choose another occasion"
+                className={`${controlClass(errors[`${copy.key}.occasion`])} mt-3`}
+                value={custom.occasionId}
+                onChange={(e) => {
+                  clear(`${copy.key}.occasion`)
+                  setCustom(copy.key, { occasionId: e.target.value })
+                }}
+              >
+                <option value="" disabled>
+                  — Or choose any other occasion —
+                </option>
+                {occasions.map((o) => (
+                  <option key={o.id} value={o.id}>
+                    {o.emoji} {o.label}
+                  </option>
+                ))}
+              </select>
+              {errors[`${copy.key}.occasion`] && (
+                <p role="alert" className="mt-1.5 flex items-center gap-1.5 text-sm text-red-600">
+                  <AlertCircle size={15} /> {errors[`${copy.key}.occasion`]}
+                </p>
+              )}
+            </div>
+
+            {occasion && (
+              <div className="mt-5 space-y-4 rounded-2xl border border-brand/20 bg-cream/60 p-4 sm:p-5">
+                <div>
+                  <h3 className="font-bold">
+                    {occasion.emoji} Details for your {occasion.label} magazine
+                  </h3>
+                  <p className="text-xs text-ink/60">Fields marked * are required. Everything else is optional.</p>
+                </div>
+                {occasion.fields.map((f) => (
+                  <Input
+                    key={f.id}
+                    name={`${copy.key}.${f.id}`}
+                    label={f.label}
+                    required={f.required}
+                    type={f.type}
+                    placeholder={f.placeholder}
+                    value={custom.values?.[f.id] ?? ''}
+                    error={errors[`${copy.key}.${f.id}`]}
+                    onChange={(v) => setValue(copy.key, f.id, v)}
+                  />
+                ))}
+                <Input
+                  name={`${copy.key}.notes`}
+                  label={settings.notesLabel}
+                  hint={settings.notesHint}
+                  multiline
+                  rows={4}
+                  placeholder="Write cute notes, sweet messages, memorable captions, quotes or wishes to include in the magazine pages…"
+                  value={custom.notes ?? ''}
+                  onChange={(v) => setCustom(copy.key, { notes: v })}
+                />
+              </div>
+            )}
+          </Card>
+        )
+      })}
+    </div>
+  )
+}
diff --git a/src/pages/order/steps/DeliveryStep.jsx b/src/pages/order/steps/DeliveryStep.jsx
new file mode 100644
index 0000000..dc6d3dd
--- /dev/null
+++ b/src/pages/order/steps/DeliveryStep.jsx
@@ -0,0 +1,147 @@
+import { CalendarDays, Info } from 'lucide-react'
+import { formatPrice } from '../../../shared/utils/format'
+import { Card, Field, Input, Notice } from '../components/FormField'
+import Calendar from '../components/Calendar'
+import { checkDate, longDate, orderingDay, rushSentence, toISO } from '../lib/pricing'
+
+export const LOCATIONS = [
+  { id: 'inside', label: 'Inside Dhaka', icon: '🏙️', chargeKey: 'insideDhakaCharge' },
+  { id: 'outside', label: 'Outside Dhaka', icon: '🚚', chargeKey: 'outsideDhakaCharge' },
+]
+
+export { longDate }
+
+export default function DeliveryStep({ ctx }) {
+  const { draft, update, errors, clear, settings, now, totals } = ctx
+  const d = draft.delivery
+  const set = (key) => (value) => {
+    clear(key)
+    update((x) => ({ ...x, delivery: { ...x.delivery, [key]: value } }))
+  }
+  const chooseLocation = (id) => {
+    clear('location', 'date')
+    update((x) => {
+      const stillOk = x.delivery.date && checkDate(x.delivery.date, id, settings, now).allowed
+      return { ...x, delivery: { ...x.delivery, location: id, date: stillOk ? x.delivery.date : '' } }
+    })
+  }
+  const rule = rushSentence(settings, formatPrice)
+  const picked = d.date && d.location ? checkDate(d.date, d.location, settings, now) : null
+
+  return (
+    <div className="space-y-6">
+      <Card>
+        <h2 className="text-lg font-bold">Who should we deliver to?</h2>
+        <p className="mt-1 text-sm text-ink/60">The person who will receive the magazine.</p>
+        <div className="mt-5 space-y-4">
+          <div className="grid gap-4 sm:grid-cols-2">
+            <Input
+              name="phone"
+              label="Contact number"
+              required
+              type="tel"
+              inputMode="tel"
+              autoComplete="tel"
+              placeholder="01XXXXXXXXX"
+              hint="The courier will call this number."
+              value={d.phone}
+              error={errors.phone}
+              onChange={set('phone')}
+            />
+            <Input
+              name="recipient"
+              label="Recipient name"
+              autoComplete="name"
+              placeholder="e.g. Sarah / Recipient's name"
+              value={d.recipient}
+              onChange={set('recipient')}
+            />
+          </div>
+          <Input
+            name="address"
+            label="Full address"
+            required
+            autoComplete="street-address"
+            placeholder="House/Flat no., Road, Area/Village"
+            value={d.address}
+            error={errors.address}
+            onChange={set('address')}
+          />
+          <Input
+            name="city"
+            label="City / District"
+            required
+            autoComplete="address-level2"
+            placeholder="e.g. Dhaka, Cumilla, Chattogram…"
+            value={d.city}
+            error={errors.city}
+            onChange={set('city')}
+          />
+          <Field name="location" label="Delivery location" required error={errors.location} hint="This sets your delivery charge.">
+            <div role="radiogroup" aria-label="Delivery location" className="grid grid-cols-2 gap-3">
+              {LOCATIONS.map((l) => (
+                <button
+                  key={l.id}
+                  type="button"
+                  role="radio"
+                  aria-checked={d.location === l.id}
+                  onClick={() => chooseLocation(l.id)}
+                  className={`rounded-2xl border-2 px-3 py-4 text-center transition ${
+                    d.location === l.id ? 'border-brand bg-cream shadow' : 'border-sand bg-white hover:border-brand/40'
+                  }`}
+                >
+                  <span className="block text-lg" aria-hidden="true">
+                    {l.icon}
+                  </span>
+                  <span className="block font-semibold">{l.label}</span>
+                  <span className="block text-sm text-warm">{formatPrice(Number(settings[l.chargeKey]) || 0)}</span>
+                </button>
+              ))}
+            </div>
+          </Field>
+        </div>
+      </Card>
+
+      <Card>
+        <h2 className="flex items-center gap-2 text-lg font-bold">
+          <CalendarDays size={20} className="text-brand" /> When do you need the magazine?
+        </h2>
+        {(rule || settings.standardNote) && (
+          <p className="mt-3 flex gap-2 rounded-xl border border-sand bg-cream px-4 py-3 text-sm leading-6 text-ink/75">
+            <Info size={16} className="mt-1 shrink-0 text-brand" />
+            <span>
+              {rule} {settings.standardNote}
+            </span>
+          </p>
+        )}
+        <div className="mt-4">
+          <Field
+            name="date"
+            label="Delivery date"
+            required
+            error={errors.date}
+            hint={d.location ? 'Tap a date. Dates with an extra charge show it under the number.' : 'Choose your delivery location above first.'}
+          >
+            <Calendar
+              key={d.location || 'none'}
+              value={d.date}
+              disabled={!d.location}
+              startISO={orderingDay(now, settings.cutoffHour)}
+              todayISO={toISO(now)}
+              getInfo={(iso) => checkDate(iso, d.location, settings, now)}
+              onChange={set('date')}
+            />
+          </Field>
+          {picked?.allowed && (
+            <p className="mt-3 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-800" aria-live="polite">
+              <strong>{longDate(d.date)}</strong>
+              {totals.rushCharge > 0
+                ? ` · Rush delivery charge +${formatPrice(totals.rushCharge)} (${totals.rushDays} day${totals.rushDays > 1 ? 's' : ''} from the order date)`
+                : ' · No rush charge'}
+            </p>
+          )}
+        </div>
+      </Card>
+    </div>
+  )
+}
diff --git a/src/pages/order/steps/MagazineStep.jsx b/src/pages/order/steps/MagazineStep.jsx
new file mode 100644
index 0000000..ea8ec9a
--- /dev/null
+++ b/src/pages/order/steps/MagazineStep.jsx
@@ -0,0 +1,223 @@
+import { AlertCircle, Check, Lightbulb } from 'lucide-react'
+import SmartImage from '../../../shared/ui/SmartImage'
+import QtyStepper from '../../../shared/ui/QtyStepper'
+import { formatPrice } from '../../../shared/utils/format'
+import { Card, Notice } from '../components/FormField'
+import { defaultSizeFor, sizesFor } from '../lib/copies'
+import { Link } from 'react-router-dom'
+
+const QUICK = [1, 2, 3, 4]
+
+export default function MagazineStep({ ctx }) {
+  const { magazine, sizes, addons, addonsFailed, formats, draft, update, errors, clear, settings } = ctx
+  const maxCopies = Math.max(1, Number(settings.maxCopies) || 1)
+
+  const toggleFormat = (format) => {
+    clear('picks', `pages.${format.id}`)
+    update((d) => {
+      const picks = { ...d.picks }
+      if (picks[format.id]) delete picks[format.id]
+      else picks[format.id] = { sizeId: defaultSizeFor(sizes, format).id, qty: 1 }
+      return { ...d, picks }
+    })
+  }
+  const setPick = (format, patch) => {
+    clear(`pages.${format.id}`)
+    update((d) => ({ ...d, picks: { ...d.picks, [format.id]: { ...d.picks[format.id], ...patch } } }))
+  }
+  const toggleAddon = (id) =>
+    update((d) => ({ ...d, addons: d.addons.includes(id) ? d.addons.filter((a) => a !== id) : [...d.addons, id] }))
+
+  return (
+    <div className="space-y-6">
+      <Card className="flex items-center gap-4">
+        <div className="size-20 shrink-0 overflow-hidden rounded-xl bg-sand sm:size-24">
+          <SmartImage src={magazine.image} alt={magazine.title} />
+        </div>
+        <div className="min-w-0 flex-1">
+          <p className="text-xs font-semibold uppercase tracking-widest text-brand">Your magazine design</p>
+          <p className="truncate font-serif text-2xl">{magazine.title}</p>
+          <Link to={`/magazines/${magazine.id}`} className="text-sm font-medium text-brand hover:underline">
+            Choose a different design
+          </Link>
+        </div>
+      </Card>
+
+      <Card data-field="picks">
+        <h2 className="text-lg font-bold">
+          Which size? <span className="text-heart">*</span>
+        </h2>
+        <p className="mt-1 text-sm text-ink/60">You can order both sizes in the same order.</p>
+        {errors.picks && (
+          <p role="alert" className="mt-3 flex items-center gap-1.5 text-sm text-red-600">
+            <AlertCircle size={15} /> {errors.picks}
+          </p>
+        )}
+
+        <div className="mt-4 grid gap-3 sm:grid-cols-2" role="group" aria-label="Magazine size">
+          {formats.map((format) => {
+            const list = sizesFor(sizes, format)
+            const on = Boolean(draft.picks[format.id])
+            const disabled = list.length === 0
+            return (
+              <button
+                key={format.id}
+                type="button"
+                role="checkbox"
+                aria-checked={on}
+                disabled={disabled}
+                onClick={() => toggleFormat(format)}
+                className={`relative rounded-2xl border-2 p-4 text-left transition disabled:cursor-not-allowed disabled:opacity-50 ${
+                  on ? 'border-brand bg-cream shadow' : 'border-sand bg-white hover:border-brand/40'
+                }`}
+              >
+                <span
+                  className={`absolute right-3 top-3 grid size-6 place-items-center rounded-full border-2 ${
+                    on ? 'border-brand bg-brand text-white' : 'border-mist text-transparent'
+                  }`}
+                >
+                  <Check size={14} />
+                </span>
+                <p className="text-lg font-bold">{format.label}</p>
+                <p className="text-sm text-ink/60">{format.note}</p>
+                <p className="mt-2 text-sm font-medium text-warm">
+                  {disabled
+                    ? 'Not available right now'
+                    : `${list[0].pages}–${list[list.length - 1].pages} pages · from ${formatPrice(Math.min(...list.map((s) => s.price)))}`}
+                </p>
+              </button>
+            )
+          })}
+        </div>
+
+        {formats
+          .filter((f) => draft.picks[f.id])
+          .map((format) => {
+            const pick = draft.picks[format.id]
+            const list = sizesFor(sizes, format)
+            const size = list.find((s) => s.id === pick.sizeId)
+            return (
+              <div key={format.id} className="mt-5 rounded-2xl border border-sand bg-cream/50 p-4 sm:p-5">
+                <div className="flex items-center justify-between gap-3">
+                  <h3 className="font-bold">{format.label}</h3>
+                  {size && <span className="rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700">✓ {size.pages}p selected</span>}
+                </div>
+
+                <div data-field={`pages.${format.id}`} className="mt-4">
+                  <p className="text-sm font-semibold">
+                    Select page count <span className="text-heart">*</span>
+                  </p>
+                  <p className="mb-3 text-xs text-ink/60">Choose the total number of pages you want in your magazine.</p>
+                  <div role="radiogroup" aria-label={`${format.label} page count`} className="grid grid-cols-2 gap-2 min-[420px]:grid-cols-3 sm:grid-cols-4">
+                    {list.map((s) => {
+                      const picked = s.id === pick.sizeId
+                      return (
+                        <button
+                          key={s.id}
+                          type="button"
+                          role="radio"
+                          aria-checked={picked}
+                          onClick={() => setPick(format, { sizeId: s.id })}
+                          className={`relative rounded-xl border-2 px-2 py-3 text-center transition ${
+                            picked ? 'border-brand bg-white shadow' : 'border-sand bg-white hover:border-brand/40'
+                          }`}
+                        >
+                          {s.tag && (
+                            <span className="absolute -top-2.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-accent px-2 py-0.5 text-[10px] font-semibold text-brand">
+                              {s.tag}
+                            </span>
+                          )}
+                          <span className="block text-base font-bold">{s.pages}p</span>
+                          {s.photos && <span className="block text-[11px] text-ink/55">~{s.photos} photos</span>}
+                          <span className="mt-1 block text-sm font-semibold text-warm">{formatPrice(s.price)}</span>
+                          {s.mrp > s.price && <span className="block text-[11px] text-ink/40 line-through">{formatPrice(s.mrp)}</span>}
+                        </button>
+                      )
+                    })}
+                  </div>
+                  {errors[`pages.${format.id}`] && (
+                    <p role="alert" className="mt-2 text-sm text-red-600">
+                      {errors[`pages.${format.id}`]}
+                    </p>
+                  )}
+                </div>
+
+                {size?.photos && (
+                  <p className="mt-4 flex items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-900">
+                    <Lightbulb size={16} className="shrink-0" /> Recommended photos: <strong>{size.photos}</strong>
+                  </p>
+                )}
+
+                <div className="mt-5">
+                  <p className="text-sm font-semibold">
+                    How many {format.label} copies do you need? <span className="text-heart">*</span>
+                  </p>
+                  <div className="mt-2 flex flex-wrap items-center gap-2">
+                    {QUICK.filter((n) => n <= maxCopies).map((n) => (
+                      <button
+                        key={n}
+                        type="button"
+                        aria-pressed={pick.qty === n}
+                        onClick={() => setPick(format, { qty: n })}
+                        className={`size-11 rounded-xl border-2 font-bold transition ${
+                          pick.qty === n ? 'border-brand bg-brand text-white' : 'border-sand bg-white hover:border-brand/40'
+                        }`}
+                      >
+                        {n}
+                      </button>
+                    ))}
+                    <span className="ml-1 text-sm text-ink/60">or</span>
+                    <QtyStepper value={pick.qty} min={1} max={maxCopies} onChange={(qty) => setPick(format, { qty })} />
+                  </div>
+                  {pick.qty > 1 && <p className="mt-2 text-xs text-ink/60">Each copy gets its own details in the next step.</p>}
+                </div>
+              </div>
+            )
+          })}
+      </Card>
+
+      {addons.length > 0 && (
+        <Card>
+          <h2 className="text-lg font-bold">
+            Add something extra <span className="ml-1 text-xs font-normal text-ink/50">(optional)</span>
+          </h2>
+          <p className="mt-1 text-sm text-ink/60">These are sold separately and added to your total. Skip this if you only want the magazine.</p>
+          <ul className="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
+            {addons.map((a) => {
+              const on = draft.addons.includes(a.id)
+              return (
+                <li key={a.id}>
+                  <button
+                    type="button"
+                    role="checkbox"
+                    aria-checked={on}
+                    onClick={() => toggleAddon(a.id)}
+                    className={`block w-full overflow-hidden rounded-2xl border-2 bg-white text-left transition ${
+                      on ? 'border-brand shadow' : 'border-sand hover:border-brand/40'
+                    }`}
+                  >
+                    <div className="relative aspect-square bg-sand">
+                      <SmartImage src={a.image} alt={a.name} placeholder="600x600" />
+                      <span
+                        className={`absolute right-2 top-2 grid size-7 place-items-center rounded-full border-2 ${
+                          on ? 'border-brand bg-brand text-white' : 'border-white bg-white/70 text-transparent'
+                        }`}
+                      >
+                        <Check size={16} />
+                      </span>
+                    </div>
+                    <div className={`px-3 py-3 text-center ${on ? 'bg-cream' : ''}`}>
+                      <p className="truncate text-sm font-semibold">{a.name}</p>
+                      {a.price > 0 && <p className="mt-0.5 text-sm font-bold text-warm">{formatPrice(a.price)}</p>}
+                    </div>
+                  </button>
+                </li>
+              )
+            })}
+          </ul>
+        </Card>
+      )}
+      {addonsFailed && <Notice tone="warn">We could not load the add-on products. You can still continue without them.</Notice>}
+    </div>
+  )
+}
diff --git a/src/pages/order/steps/PhotosStep.jsx b/src/pages/order/steps/PhotosStep.jsx
new file mode 100644
index 0000000..e9fe28e
--- /dev/null
+++ b/src/pages/order/steps/PhotosStep.jsx
@@ -0,0 +1,129 @@
+import { useReducer, useRef, useState } from 'react'
+import { ImagePlus, Trash2 } from 'lucide-react'
+import { Card, Notice } from '../components/FormField'
+import { copyTitle } from '../lib/copies'
+import { parseRange } from '../lib/pricing'
+import { photoStore } from '../lib/photoStore'
+
+function PhotoPanel({ copy, ctx, refresh }) {
+  const { occasions, draft, update } = ctx
+  const input = useRef(null)
+  const [message, setMessage] = useState('')
+  const photos = photoStore.list(copy.key)
+  const range = parseRange(copy.size.photos)
+  const meta = draft.photos[copy.key] ?? {}
+  const front = photos.find((p) => p.id === meta.front)?.id
+  const back = photos.find((p) => p.id === meta.back)?.id
+  const theme = occasions.find((o) => o.id === draft.customs[copy.key]?.occasionId)
+
+  const setMeta = (patch) => update((d) => ({ ...d, photos: { ...d.photos, [copy.key]: { ...d.photos[copy.key], ...patch } } }))
+  const add = (e) => {
+    const result = photoStore.add(copy.key, e.target.files)
+    e.target.value = ''
+    const notes = []
+    if (result.rejected) notes.push(`${result.rejected} file${result.rejected > 1 ? 's were' : ' was'} not a picture and ${result.rejected > 1 ? 'were' : 'was'} skipped.`)
+    if (result.skipped) notes.push(`${result.skipped} photo${result.skipped > 1 ? 's were' : ' was'} already added.`)
+    setMessage(notes.join(' '))
+    refresh()
+  }
+  const remove = (id) => {
+    photoStore.remove(copy.key, id)
+    if (meta.front === id) setMeta({ front: null })
+    if (meta.back === id) setMeta({ back: null })
+    refresh()
+  }
+  // A photo can be the front or the back, not both
+  const pick = (slot, id) => {
+    const other = slot === 'front' ? 'back' : 'front'
+    setMeta({ [slot]: meta[slot] === id ? null : id, ...(meta[other] === id ? { [other]: null } : {}) })
+  }
+
+  const below = range && photos.length < range.min
+  return (
+    <Card aria-label={copyTitle(copy)}>
+      <div className="flex flex-wrap items-center gap-2">
+        <h2 className="mr-1 font-bold">{copyTitle(copy)}</h2>
+        {theme && <span className="rounded-full border border-sand bg-cream px-3 py-1 text-xs font-medium">Theme: {theme.label}</span>}
+        {range && <span className="rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-900">Recommended: {copy.size.photos} photos</span>}
+        <span className="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800" aria-live="polite">
+          {photos.length} photo{photos.length === 1 ? '' : 's'} added
+        </span>
+      </div>
+
+      <input ref={input} type="file" accept="image/*" multiple hidden onChange={add} data-testid={`photo-input-${copy.key}`} />
+      <button
+        type="button"
+        onClick={() => input.current?.click()}
+        className="mt-4 flex w-full items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-brand/40 bg-cream px-4 py-6 font-semibold text-brand transition hover:border-brand hover:bg-sand"
+      >
+        <ImagePlus size={20} /> {photos.length ? 'Add more photos' : 'Choose photos'}
+      </button>
+      {message && <p className="mt-2 text-sm text-amber-800">{message}</p>}
+      {below && photos.length > 0 && (
+        <p className="mt-2 text-sm text-amber-800">
+          {range.min - photos.length} more photo{range.min - photos.length === 1 ? '' : 's'} would fill your pages nicely, but you can still continue.
+        </p>
+      )}
+
+      {photos.length > 0 && (
+        <>
+          <p className="mb-2 mt-5 text-sm font-semibold">Pick the Front Page and Back Page photos</p>
+          <ul className="grid grid-cols-2 gap-3 min-[480px]:grid-cols-3 sm:grid-cols-4">
+            {photos.map((p) => (
+              <li key={p.id} className="overflow-hidden rounded-xl border border-sand bg-white">
+                <div className="relative aspect-square bg-sand">
+                  {p.url ? (
+                    <img src={p.url} alt={p.name} className="h-full w-full object-cover" />
+                  ) : (
+                    <span className="grid h-full place-items-center p-2 text-center text-xs text-ink/50">{p.name}</span>
+                  )}
+                  <button
+                    type="button"
+                    aria-label={`Remove ${p.name}`}
+                    onClick={() => remove(p.id)}
+                    className="absolute right-1.5 top-1.5 grid size-8 place-items-center rounded-full bg-white/90 text-red-500 shadow hover:bg-white"
+                  >
+                    <Trash2 size={15} />
+                  </button>
+                  {(front === p.id || back === p.id) && (
+                    <span className="absolute bottom-1.5 left-1.5 rounded-full bg-brand px-2.5 py-0.5 text-[11px] font-bold text-white">
+                      {front === p.id ? 'Front page' : 'Back page'}
+                    </span>
+                  )}
+                </div>
+                <div className="grid grid-cols-2 gap-1 p-1.5">
+                  {['front', 'back'].map((slot) => (
+                    <button
+                      key={slot}
+                      type="button"
+                      aria-pressed={meta[slot] === p.id}
+                      aria-label={`Use ${p.name} as ${slot} page`}
+                      onClick={() => pick(slot, p.id)}
+                      className={`rounded-lg py-1.5 text-xs font-semibold capitalize transition ${
+                        meta[slot] === p.id ? 'bg-brand text-white' : 'bg-sand text-brand hover:bg-mist'
+                      }`}
+                    >
+                      {slot}
+                    </button>
+                  ))}
+                </div>
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+    </Card>
+  )
+}
+
+export default function PhotosStep({ ctx }) {
+  const [, refresh] = useReducer((n) => n + 1, 0)
+  return (
+    <div className="space-y-6">
+      <Notice tone="warn">{ctx.settings.photosNote}</Notice>
+      {ctx.copies.map((copy) => (
+        <PhotoPanel key={copy.key} copy={copy} ctx={ctx} refresh={refresh} />
+      ))}
+    </div>
+  )
+}
