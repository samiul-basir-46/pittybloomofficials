diff --git a/src/pages/order/lib/useUploads.js b/src/pages/order/lib/useUploads.js
new file mode 100644
index 0000000..01753d1
--- /dev/null
+++ b/src/pages/order/lib/useUploads.js
@@ -0,0 +1,123 @@
+import { useRef, useState } from 'react'
+import { photoService, validatePhoto } from '../../../shared/services/photoService'
+import { emptyPhotos } from './orderDraft'
+
+const PARALLEL = 3
+const newId = () => globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`
+const safeName = (name) => name.replace(/[^\w.-]+/g, '_').slice(-80)
+
+// Photo uploads for the wizard. Lives in the wizard (not the Photos step), so an upload keeps going
+// and its result is saved in the draft even if the customer moves to another step.
+export default function useUploads({ draft, update, settings }) {
+  const [uploads, setUploads] = useState({}) // copyKey → [{ tempId, name, progress, status, error, file, replaceId }]
+  const draftRef = useRef(draft)
+  draftRef.current = draft
+  const running = useRef(0)
+  const queue = useRef([])
+
+  const patch = (key, tempId, change) =>
+    setUploads((u) => ({ ...u, [key]: (u[key] ?? []).map((x) => (x.tempId === tempId ? { ...x, ...change } : x)) }))
+  const drop = (key, tempId) => setUploads((u) => ({ ...u, [key]: (u[key] ?? []).filter((x) => x.tempId !== tempId) }))
+
+  const setMeta = (key, fn) =>
+    update((d) => ({ ...d, photos: { ...d.photos, [key]: fn(d.photos[key] ?? emptyPhotos()) } }))
+
+  const start = async (job) => {
+    const { copy, tempId, file, replaceId } = job
+    const [format, n] = copy.key.split(':')
+    const id = newId()
+    const path = `orders/${draftRef.current.orderId}/${format}/copy-${n}/${id}-${safeName(file.name)}`
+    patch(copy.key, tempId, { status: 'uploading', progress: 0, error: '' })
+    try {
+      const stored = await photoService.upload(file, { path, onProgress: (progress) => patch(copy.key, tempId, { progress }) })
+      const record = { id, ...stored }
+      setMeta(copy.key, (m) => {
+        // Replacing keeps the old photo's place and its Front / Back role
+        if (replaceId && m.files.some((f) => f.id === replaceId))
+          return {
+            files: m.files.map((f) => (f.id === replaceId ? record : f)),
+            front: m.front === replaceId ? id : m.front,
+            back: m.back === replaceId ? id : m.back,
+          }
+        return { ...m, files: [...m.files, record] }
+      })
+      if (replaceId) {
+        const previous = draftRef.current.photos[copy.key]?.files.find((f) => f.id === replaceId)
+        if (previous) photoService.remove(previous).catch(() => {})
+      }
+      drop(copy.key, tempId)
+    } catch (error) {
+      patch(copy.key, tempId, { status: 'error', error: error.message || 'Upload failed. Please try again.' })
+    }
+  }
+
+  const pump = () => {
+    while (running.current < PARALLEL && queue.current.length) {
+      const job = queue.current.shift()
+      running.current += 1
+      start(job).finally(() => {
+        running.current -= 1
+        pump()
+      })
+    }
+  }
+
+  // Returns { problems: [text], skipped } straight away so the screen can explain; uploads then run in the background.
+  const add = (copy, fileList, { replaceId } = {}) => {
+    const existing = draftRef.current.photos[copy.key]?.files ?? []
+    const pending = uploads[copy.key] ?? []
+    const problems = []
+    let skipped = 0
+    const jobs = []
+    Array.from(fileList).forEach((file) => {
+      const message = validatePhoto(file, Number(settings.maxPhotoMB) || 15)
+      if (message) return void problems.push(message)
+      const same = (f) => f.name === file.name && f.size === file.size
+      if (!replaceId && (existing.some(same) || pending.some(same) || jobs.some((j) => same(j.file)))) return void skipped++
+      jobs.push({ copy, file, replaceId, tempId: newId() })
+    })
+    if (jobs.length) {
+      setUploads((u) => ({
+        ...u,
+        [copy.key]: [...(u[copy.key] ?? []), ...jobs.map((j) => ({ tempId: j.tempId, name: j.file.name, progress: 0, status: 'waiting', error: '', file: j.file, replaceId: j.replaceId }))],
+      }))
+      queue.current.push(...jobs)
+      pump()
+    }
+    return { problems, skipped }
+  }
+
+  const retry = (copy, item) => {
+    queue.current.push({ copy, file: item.file, replaceId: item.replaceId, tempId: item.tempId })
+    patch(copy.key, item.tempId, { status: 'waiting', progress: 0, error: '' })
+    pump()
+  }
+
+  const remove = (copy, fileId) => {
+    const file = draftRef.current.photos[copy.key]?.files.find((f) => f.id === fileId)
+    setMeta(copy.key, (m) => ({
+      files: m.files.filter((f) => f.id !== fileId),
+      front: m.front === fileId ? null : m.front,
+      back: m.back === fileId ? null : m.back,
+    }))
+    if (file) photoService.remove(file).catch(() => {})
+  }
+
+  // Front and back are chosen per copy. A photo cannot be both, and choosing it again un-chooses it.
+  const assign = (copy, slot, fileId) => {
+    const other = slot === 'front' ? 'back' : 'front'
+    setMeta(copy.key, (m) => ({ ...m, [slot]: m[slot] === fileId ? null : fileId, ...(m[other] === fileId ? { [other]: null } : {}) }))
+  }
+
+  const all = Object.values(uploads).flat()
+  return {
+    uploads,
+    busy: all.some((x) => x.status === 'uploading' || x.status === 'waiting'),
+    failed: all.some((x) => x.status === 'error'),
+    add,
+    retry,
+    dismiss: (copy, tempId) => drop(copy.key, tempId),
+    remove,
+    assign,
+  }
+}
