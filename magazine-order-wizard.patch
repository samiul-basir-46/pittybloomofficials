+import { useEffect, useRef, useState } from 'react'
+import { ChevronLeft, ChevronRight, ImageOff, X } from 'lucide-react'
+import { photoService } from '../services/photoService'
+
+// Loads a stored photo as a temporary browser URL and cleans it up afterwards.
+export function usePhotoUrl(path) {
+  const [state, setState] = useState({ url: '', failed: false })
+  useEffect(() => {
+    let live = true
+    let made = ''
+    setState({ url: '', failed: false })
+    if (!path) return undefined
+    photoService
+      .getBlob(path)
+      .then((blob) => {
+        if (!live) return
+        if (!blob) return setState({ url: '', failed: true })
+        made = URL.createObjectURL(blob)
+        setState({ url: made, failed: false })
+      })
+      .catch(() => live && setState({ url: '', failed: true }))
+    return () => {
+      live = false
+      if (made) URL.revokeObjectURL(made)
+    }
+  }, [path])
+  return state
+}
+
+export const ROLE_LABEL = { front: 'Front page', back: 'Back page' }
+
+// Front first, then back, then the rest in the order they were added.
+export const orderPhotos = (files = []) => [
+  ...files.filter((f) => f.role === 'front'),
+  ...files.filter((f) => f.role === 'back'),
+  ...files.filter((f) => f.role !== 'front' && f.role !== 'back'),
+]
+
+function Picture({ file, full = false, className = '' }) {
+  const { url, failed } = usePhotoUrl(full ? file.path : (file.thumbPath ?? file.path))
+  const [broken, setBroken] = useState(false)
+  if (url && !broken)
+    return <img src={url} alt={file.name} onError={() => setBroken(true)} className={`${full ? 'max-h-full max-w-full object-contain' : 'h-full w-full object-cover'} ${className}`} />
+  return (
+    <span className="grid h-full w-full place-items-center gap-1 p-2 text-center text-[11px] leading-tight text-ink/50">
+      <ImageOff size={20} className="mx-auto" aria-hidden="true" />
+      <span className="line-clamp-2 [overflow-wrap:anywhere]">{failed || broken ? 'Preview not available on this device' : file.name}</span>
+    </span>
+  )
+}
+
+export function Lightbox({ files, index, onClose, onIndex, caption }) {
+  const file = files[index]
+  const closeRef = useRef(null)
+  useEffect(() => {
+    closeRef.current?.focus()
+    const previous = document.activeElement
+    const onKey = (e) => {
+      if (e.key === 'Escape') onClose()
+      if (e.key === 'ArrowLeft' && index > 0) onIndex(index - 1)
+      if (e.key === 'ArrowRight' && index < files.length - 1) onIndex(index + 1)
+    }
+    window.addEventListener('keydown', onKey)
+    return () => {
+      window.removeEventListener('keydown', onKey)
+      previous?.focus?.()
+    }
+  }, [index, files.length, onClose, onIndex])
+  if (!file) return null
+  const nav = 'absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-ink shadow hover:bg-white disabled:hidden'
+  return (
+    <div
+      role="dialog"
+      aria-modal="true"
+      aria-label="Photo preview"
+      className="fixed inset-0 z-[80] flex flex-col bg-black/90 p-3 sm:p-6"
+      onMouseDown={(e) => e.target === e.currentTarget && onClose()}
+    >
+      <div className="flex items-start justify-between gap-4 text-white">
+        <p className="min-w-0 text-sm [overflow-wrap:anywhere]">
+          <span className="font-semibold">{caption(file)}</span>
+          <span className="ml-2 text-white/60">
+            {index + 1} / {files.length}
+          </span>
+        </p>
+        <button ref={closeRef} type="button" aria-label="Close preview" onClick={onClose} className="grid size-10 shrink-0 place-items-center rounded-full bg-white/15 hover:bg-white/30">
+          <X size={20} />
+        </button>
+      </div>
+      <div className="relative mt-3 flex min-h-0 flex-1 items-center justify-center" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
+        <div className="flex h-full w-full items-center justify-center text-white">
+          <Picture key={file.path} file={file} full />
+        </div>
+        <button type="button" aria-label="Previous photo" disabled={index === 0} onClick={() => onIndex(index - 1)} className={`${nav} left-0`}>
+          <ChevronLeft size={22} />
+        </button>
+        <button type="button" aria-label="Next photo" disabled={index === files.length - 1} onClick={() => onIndex(index + 1)} className={`${nav} right-0`}>
+          <ChevronRight size={22} />
+        </button>
+      </div>
+    </div>
+  )
+}
+
+// Grid of photo thumbnails. Clicking one opens it large. files: [{ path, thumbPath, name, role }]
+export function PhotoGrid({ files, caption = (f) => f.name, size = 'md' }) {
+  const [open, setOpen] = useState(-1)
+  const list = orderPhotos(files)
+  const cols = size === 'sm' ? 'grid-cols-4 min-[480px]:grid-cols-6 sm:grid-cols-8' : 'grid-cols-3 min-[480px]:grid-cols-4 sm:grid-cols-5'
+  return (
+    <>
+      <ul className={`grid gap-2 ${cols}`}>
+        {list.map((f, i) => (
+          <li key={f.path}>
+            <button
+              type="button"
+              onClick={() => setOpen(i)}
+              aria-label={`View ${f.name}${ROLE_LABEL[f.role] ? ` (${ROLE_LABEL[f.role]})` : ''}`}
+              className="relative block aspect-square w-full overflow-hidden rounded-xl border border-sand bg-sand transition hover:border-brand"
+            >
+              <Picture file={f} />
+              {ROLE_LABEL[f.role] && (
+                <span className="absolute inset-x-0 bottom-0 bg-brand/90 py-0.5 text-center text-[11px] font-bold text-white">{ROLE_LABEL[f.role]}</span>
+              )}
+            </button>
+          </li>
+        ))}
+      </ul>
+      {open >= 0 && <Lightbox files={list} index={open} onIndex={setOpen} onClose={() => setOpen(-1)} caption={(f) => `${caption(f)}${ROLE_LABEL[f.role] ? ` · ${ROLE_LABEL[f.role]}` : ''}`} />}
+    </>
+  )
+}
+
+export { Picture as PhotoPicture }
