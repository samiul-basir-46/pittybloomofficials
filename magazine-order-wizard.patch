+++ b/src/pages/order/__tests__/adminPhotos.test.jsx
@@ -0,0 +1,103 @@
+import { describe, expect, it, vi } from 'vitest'
+import { render, screen, waitFor, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import JSZip from 'jszip'
+import { photoService } from '../../../shared/services/photoService'
+import { ordersApi } from '../../../shared/services/contentService'
+import { buildOrderZip, zipEntries } from '../../../admin/orderZip'
+import OrdersPage from '../../../admin/OrdersPage'
+
+const file = (id, name, role, orderId, magazineNo, copyNo) => ({
+  id, name, role, type: 'image/jpeg', size: 3, orderId, magazineNo, copyNo,
+  path: `orders/${orderId}/A${magazineNo}/copy-${copyNo}/${id}-${name}`, thumbPath: null,
+})
+const item = (magazineNo, copyNo, files) => ({
+  kind: 'magazine', id: 'm', name: 'Couple', optionLabel: 'A4 Magazine · 8 Pages', qty: 1, price: 549, photos: { count: files.length, magazineNo, copyNo, files },
+})
+const store = (f) => photoService.upload(new File([new Uint8Array([1, 2, 3])], f.name, { type: 'image/jpeg' }), { path: f.path })
+
+const order = {
+  id: 'ORDER-12345', createdAt: '2026-10-18T10:00:00.000Z', status: 'New',
+  customer: { name: 'Fahim', phone: '017', address: 'Road 1, Dhaka', email: 'f@example.com' },
+  magazineTotal: 1098, addonTotal: 0, otherTotal: 0, total: 1098, delivery: 'Inside Dhaka',
+  items: [
+    item(1, 1, [file('p1', 'sunset.jpg', 'front', 'ORDER-12345', 1, 1), file('p2', 'beach.jpg', 'back', 'ORDER-12345', 1, 1), file('p3', 'extra.jpg', 'photo', 'ORDER-12345', 1, 1)]),
+    item(1, 2, [file('p4', 'a.jpg', 'front', 'ORDER-12345', 1, 2), file('p5', 'b.jpg', 'back', 'ORDER-12345', 1, 2)]),
+  ],
+}
+
+describe('Admin photo ZIP', () => {
+  it('names folders and files clearly: ORDER-ID/Magazine-1/Copy-1/Front.jpg …', () => {
+    expect(zipEntries(order).map((e) => e.path)).toEqual([
+      'ORDER-12345/Magazine-1/Copy-1/Front.jpg',
+      'ORDER-12345/Magazine-1/Copy-1/Back.jpg',
+      'ORDER-12345/Magazine-1/Copy-1/Photo-01.jpg',
+      'ORDER-12345/Magazine-1/Copy-2/Front.jpg',
+      'ORDER-12345/Magazine-1/Copy-2/Back.jpg',
+    ])
+  })
+
+  it('builds a real ZIP with the stored photos', async () => {
+    for (const i of order.items) for (const f of i.photos.files) await store(f)
+    const { blob, added, missing } = await buildOrderZip(order)
+    expect(added).toBe(5)
+    expect(missing).toEqual([])
+    const buffer = await new Promise((resolve, reject) => {
+      const reader = new FileReader()
+      reader.onload = () => resolve(reader.result)
+      reader.onerror = reject
+      reader.readAsArrayBuffer(blob)
+    })
+    const zip = await JSZip.loadAsync(buffer)
+    expect(Object.keys(zip.files).filter((n) => !n.endsWith('/')).sort()).toContain('ORDER-12345/Magazine-1/Copy-2/Back.jpg')
+    expect([...(await zip.file('ORDER-12345/Magazine-1/Copy-1/Front.jpg').async('uint8array'))]).toEqual([1, 2, 3])
+  })
+
+  it('keeps going when one photo is missing and lists it, and fails clearly when none can be read', async () => {
+    await store(order.items[0].photos.files[0])
+    const partial = await buildOrderZip(order)
+    expect(partial.added).toBe(1)
+    expect(partial.missing).toHaveLength(4)
+    await photoService.removeByPrefix('orders/ORDER-12345/')
+    await expect(buildOrderZip(order)).rejects.toThrow(/not stored on this device/i)
+  })
+})
+
+describe('Admin Orders page', () => {
+  it('shows each copy with its photos, enlarges them, and offers the ZIP download', async () => {
+    await ordersApi.save(order)
+    const user = userEvent.setup()
+    render(<OrdersPage />)
+    await user.click(await screen.findByText('ORDER-12345'))
+
+    expect(screen.getByText(/magazine 1 · copy 1/i, { selector: 'p' })).toBeInTheDocument()
+    expect(screen.getByText(/magazine 1 · copy 2/i, { selector: 'p' })).toBeInTheDocument()
+    expect(screen.getAllByRole('button', { name: /^view .*\(front page\)$/i })).toHaveLength(2)
+    expect(screen.getByRole('button', { name: 'View sunset.jpg (Front page)' })).toBeInTheDocument()
+    expect(screen.getByText('f@example.com')).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: /download all photos \(\.zip\) · 5/i })).toBeInTheDocument()
+
+    await user.click(screen.getByRole('button', { name: 'View beach.jpg (Back page)' }))
+    expect(within(screen.getByRole('dialog')).getByText(/beach\.jpg · back page/i)).toBeInTheDocument()
+  })
+
+  it('reports a ZIP that cannot be made instead of failing silently', async () => {
+    await ordersApi.save(order)
+    const user = userEvent.setup()
+    render(<OrdersPage />)
+    await user.click(await screen.findByText('ORDER-12345'))
+    await user.click(screen.getByRole('button', { name: /download all photos/i }))
+    expect(await screen.findByRole('alert')).toHaveTextContent(/not stored on this device/i)
+  })
+
+  it('deleting an order also deletes its photos', async () => {
+    await ordersApi.save(order)
+    await store(order.items[0].photos.files[0])
+    vi.spyOn(window, 'confirm').mockReturnValue(true)
+    const user = userEvent.setup()
+    render(<OrdersPage />)
+    await user.click(await screen.findByText('ORDER-12345'))
+    await user.click(screen.getByRole('button', { name: /delete order/i }))
+    await waitFor(async () => expect(await photoService.getBlob(order.items[0].photos.files[0].path)).toBeNull())
+  })
+})
