[debug] [2026-10-19T19:39:14.168Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/pittybloomofficials/rulesets {"name":"projects/pittybloomofficials/rulesets/7a66aa65-6e70-4b9b-b061-bba05bc1133e","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isAdmin() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))\n        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    // Admin records are provisioned manually in the Firebase Console. A user can\n    // read their own role but cannot grant themselves or anyone else admin access.\n    match /admins/{uid} {\n      allow read: if signedIn() && request.auth.uid == uid;\n      allow write: if false;\n    }\n\n    match /orders/{orderId} {\n      allow create: if isAdmin() || (signedIn()\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.id == orderId\n        && request.resource.data.status == 'New'\n        && request.resource.data.customer.uid == request.auth.uid\n        && request.resource.data.customer.email == request.auth.token.email\n        && request.resource.data.items is list\n        && request.resource.data.total is number\n        && request.resource.data.total >= 0);\n      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /drafts/{draftId} {\n      allow create: if signedIn()\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.id == draftId\n        && request.resource.data.status == 'draft';\n      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);\n      allow update: if isAdmin() || (signedIn()\n        && resource.data.ownerUid == request.auth.uid\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.status == 'draft');\n      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);\n    }\n\n    match /contentData/{docId} {\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /{document=**} { allow read, write: if false; }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-19T19:39:13.463859Z","metadata":{"services":["cloud.firestore"]}}
